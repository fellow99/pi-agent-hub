{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pi-agent-hub",
  "version": "0.1.0",
  "identifier": "com.piagenthub.tray",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "config",
        "title": "pi-agent-hub",
        "width": 760,
        "height": 620,
        "center": true,
        "resizable": false,
        "maximizable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../sync-daemon-starter.js": "sync-daemon-starter.js",
      "resources/node": "node",
      "resources/node_modules": "node_modules",
      "resources/bundle-manifest.json": "bundle-manifest.json"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}