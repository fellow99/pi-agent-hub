{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pi-agent-hub",
  "version": "0.1.0",
  "identifier": "com.piagenthub.tray",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "config",
        "title": "pi-agent-hub",
        "width": 760,
        "height": 620,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
