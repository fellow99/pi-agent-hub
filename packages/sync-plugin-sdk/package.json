{
  "name": "@pi-agent-hub/sync-plugin-sdk",
  "version": "0.1.1",
  "description": "pi-agent-hub sync-daemon 插件 SDK：JSON-RPC/stdio 子进程协议、canonical 输出与 CLI 工具",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@pi-agent-hub/pi-session": "workspace:^",
    "@pi-agent-hub/protocol": "workspace:^"
  }
}
